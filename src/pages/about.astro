---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR, BIO, GITHUB_URL, SITE_TITLE, TAGLINE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`关于 · ${SITE_TITLE}`} description={BIO} />
	</head>
	<body>
		<Header />
		<main>
			<h1>关于我</h1>
			<p class="tagline">{TAGLINE}</p>
			<p>{BIO}</p>
			<p>
				我的代码都在 <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a> 上，做过的东西可以去<a
					href="/projects">项目页</a
				>看看。
			</p>
			<p class="sign">— {AUTHOR}</p>
		</main>
		<Footer />
	</body>
</html>
<style>
	.tagline {
		font-weight: 600;
		color: var(--accent);
	}
	.sign {
		color: rgb(var(--gray));
	}
</style>
