---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { AUTHOR, AVATAR, BIO, GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE, TAGLINE } from '../consts';
import { projects } from '../data/projects';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="avatar">{AVATAR}</div>
				<h1>{AUTHOR}</h1>
				<p class="tagline">{TAGLINE}</p>
				<p class="bio">{BIO}</p>
				<div class="socials">
					<a href={GITHUB_URL} target="_blank" rel="noopener">🐙 GitHub</a>
				</div>
			</section>

			<section>
				<h2 class="section-title">项目作品</h2>
				<div class="project-grid">
					{projects.slice(0, 4).map((p) => <ProjectCard {...p} />)}
				</div>
				{projects.length > 4 && <p class="more"><a href="/projects">全部项目 →</a></p>}
			</section>

			<section>
				<h2 class="section-title">博客文章</h2>
				{
					posts.length ? (
						<div class="post-list">
							{posts.map((post) => (
								<a class="post-item" href={`/blog/${post.id}/`}>
									<div class="post-meta">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</a>
							))}
						</div>
					) : (
						<p class="empty">还没有文章。</p>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	section {
		padding: 1.5em 0;
	}
	.hero {
		padding-top: 1em;
	}
	.avatar {
		display: grid;
		place-items: center;
		width: 84px;
		height: 84px;
		margin-bottom: 22px;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 50%;
		background: color-mix(in srgb, var(--accent) 10%, #fff);
		font-size: 34px;
	}
	.hero h1 {
		margin: 0 0 8px;
		font-size: 1.7em;
		letter-spacing: -0.02em;
	}
	.tagline {
		margin: 0 0 18px;
		font-size: 0.8em;
		font-weight: 600;
		color: var(--accent);
	}
	.bio {
		max-width: 58ch;
		margin: 0 0 26px;
		font-size: 0.85em;
		color: rgb(var(--gray));
	}
	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.socials a {
		padding: 7px 14px;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		background: #fff;
		font-size: 0.7em;
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.socials a:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.section-title {
		margin: 0 0 24px;
		font-size: 0.65em;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
	.more {
		margin: 16px 0 0;
		font-size: 0.8em;
	}
	.post-list {
		display: flex;
		flex-direction: column;
	}
	.post-item {
		display: block;
		padding: 20px 0;
		border-top: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	.post-item:first-child {
		padding-top: 0;
		border-top: none;
	}
	.post-item:hover h3 {
		color: var(--accent);
	}
	.post-meta {
		margin-bottom: 4px;
		font-size: 0.65em;
		color: rgb(var(--gray));
	}
	.post-item h3 {
		margin: 0 0 6px;
		font-size: 0.9em;
	}
	.post-item p {
		margin: 0;
		font-size: 0.75em;
		color: rgb(var(--gray));
	}
	.empty {
		padding: 20px;
		border: 1px dashed rgb(var(--gray-light));
		border-radius: 14px;
		font-size: 0.75em;
		text-align: center;
		color: rgb(var(--gray));
	}
</style>
