---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}

const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
	items.length >= 3 && (
		<nav class="toc" aria-label="文章目录">
			<p class="toc-title">目录</p>
			<ol>
				{items.map((h) => (
					<li class={`depth-${h.depth}`}>
						<a href={`#${h.slug}`} data-slug={h.slug}>
							{h.text}
						</a>
					</li>
				))}
			</ol>
		</nav>
	)
}

<script>
	const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a[data-slug]')];
	const headings = links
		.map((a) => document.getElementById(a.dataset.slug!))
		.filter((el): el is HTMLElement => el !== null);

	if (headings.length) {
		const setActive = (id: string) => {
			for (const a of links) {
				const on = a.dataset.slug === id;
				a.classList.toggle('active', on);
				if (on) a.setAttribute('aria-current', 'location');
				else a.removeAttribute('aria-current');
			}
		};

		// 标题穿过视口上方 30% 那条线时触发；当前章节 = 最后一个已经越过这条线的标题
		const update = () => {
			const line = window.innerHeight * 0.3;
			let current = headings[0];
			for (const h of headings) {
				if (h.getBoundingClientRect().top <= line) current = h;
				else break;
			}
			setActive(current.id);
		};

		const observer = new IntersectionObserver(update, {
			rootMargin: '0px 0px -70% 0px',
			threshold: [0, 1],
		});
		headings.forEach((h) => observer.observe(h));
		update();
	}
</script>

<style>
	.toc {
		position: sticky;
		top: 2rem;
		max-height: calc(100vh - 4rem);
		overflow-y: auto;
		font-size: 0.75em;
		line-height: 1.5;
	}
	.toc-title {
		margin: 0 0 0.75em;
		font-size: 0.85em;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: rgb(var(--gray));
	}
	ol {
		margin: 0;
		padding: 0;
		list-style: none;
		border-left: 2px solid rgb(var(--gray-light));
	}
	li {
		margin: 0;
	}
	a {
		display: block;
		margin-left: -2px;
		padding: 0.3em 0 0.3em 0.9em;
		border-left: 2px solid transparent;
		color: rgb(var(--gray));
		text-decoration: none;
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}
	.depth-3 a {
		padding-left: 1.8em;
		font-size: 0.92em;
	}
	a:hover {
		color: rgb(var(--gray-dark));
	}
	a.active {
		border-left-color: var(--accent);
		color: var(--accent);
		font-weight: 700;
	}
	@media (prefers-reduced-motion: reduce) {
		a {
			transition: none;
		}
	}
</style>
