---
import type { Project } from '../data/projects';

type Props = Project;

const { icon, title, desc, tags, url } = Astro.props;
---

<a class="card" href={url} target="_blank" rel="noopener">
	<div class="card-icon">{icon}</div>
	<h3>{title}</h3>
	<p>{desc}</p>
	<div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>
</a>
<style>
	.card {
		display: flex;
		flex-direction: column;
		padding: 20px;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 14px;
		background: #fff;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition:
			transform 0.18s ease,
			box-shadow 0.18s ease,
			border-color 0.18s ease;
	}
	.card:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--accent) 40%, rgb(var(--gray-light)));
		box-shadow:
			0 1px 2px rgba(16, 24, 40, 0.04),
			0 10px 28px rgba(16, 24, 40, 0.07);
	}
	.card-icon {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		margin-bottom: 14px;
		border-radius: 10px;
		background: color-mix(in srgb, var(--accent) 10%, #fff);
		font-size: 19px;
	}
	h3 {
		margin: 0 0 6px;
		font-size: 0.85em;
		color: rgb(var(--black));
	}
	p {
		flex: 1;
		margin: 0 0 14px;
		font-size: 0.75em;
		color: rgb(var(--gray));
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.tag {
		padding: 3px 8px;
		border-radius: 6px;
		background: rgb(var(--gray-light));
		font-size: 0.6em;
		color: rgb(var(--gray-dark));
	}
	@media (prefers-reduced-motion: reduce) {
		.card {
			transition: none;
		}
	}
</style>
